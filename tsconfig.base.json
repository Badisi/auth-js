{
    "extends": "./tsconfig.strict.json",
    "compilerOptions": {
        "target": "esnext",
        "lib": [
            "esnext",
            "dom"
        ],
        "module": "preserve",
        "moduleResolution": "bundler",
        "customConditions": [
            "development"
        ],
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmitOnError": true,
        "sourceMap": true
    }
}
