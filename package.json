{
    "name": "@badisi/auth-js",
    "description": "Authentication and authorization support for web based desktop and mobile applications.",
    "homepage": "https://github.com/Badisi/auth-js",
    "license": "GPL-3.0-only",
    "author": "Badisi",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Badisi/auth-js.git"
    },
    "keywords": [
        "authentication",
        "authorization",
        "oidc",
        "openidconnect",
        "openid",
        "security",
        "identity",
        "oauth2",
        "oauth",
        "auth",
        "authn",
        "web",
        "mobile"
    ],
    "private": true,
    "scripts": {
        "check-updates": "npx @badisi/check-updates -i '{,apps/**/,libs/**/}package.json'",
        "migrate:nx": "nx migrate latest",
        "migrate:cap": "cap migrate",
        "verify": "nx sync && nx run-many -t typecheck,build,lint,test",
        "lint": "eslint .",
        "test:ci": "nx run-many --target=test:ci --projects=auth-js,ngx-auth,auth-vue --output-style=static",
        "build": "nx run-many --target=build --projects=auth-js,ngx-auth,auth-vue --output-style=static --verbose",
        "release": "nx release --verbose",
        "release:dry-run": "nx release --verbose --dry-run",
        "postinstall": "patch-package",
        "prepare": "husky || true"
    },
    "workspaces": [
        "apps/demo-app/capacitor",
        "apps/demo-app/web",
        "apps/demo-e2e",
        "apps/demo-idp",
        "apps/website",
        "libs/auth-js",
        "libs/auth-vue",
        "libs/ngx-auth"
    ],
    "dependencies": {
        "@angular/common": "^21.2.19",
        "@angular/compiler": "^21.2.19",
        "@angular/core": "^21.2.19",
        "@angular/forms": "^21.2.19",
        "@angular/platform-browser": "^21.2.19",
        "@angular/router": "^21.2.19",
        "rxjs": "7.8.2",
        "vue": "3.5.40",
        "vue-router": "5.2.0",
        "zone.js": "0.16.2"
    },
    "devDependencies": {
        "@angular-devkit/core": "^21.2.19",
        "@angular-devkit/schematics": "^21.2.19",
        "@angular/build": "^21.2.19",
        "@angular/cli": "^21.2.19",
        "@angular/compiler-cli": "^21.2.19",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@hug/eslint-config": "^26.0.0",
        "@nx/angular": "22.7.5",
        "@nx/eslint": "22.7.5",
        "@nx/js": "22.7.5",
        "@nx/vite": "22.7.5",
        "@nx/vitest": "22.7.5",
        "@nx/vue": "22.7.5",
        "@nx/web": "22.7.5",
        "@types/node": "26.1.2",
        "@vitejs/plugin-vue": "6.0.8",
        "@vitest/coverage-v8": "~4.1.10",
        "detect-indent": "^7.0.2",
        "generate-license-file": "^4.2.1",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.3.0",
        "ng-packagr": "21.2.3",
        "nx": "22.7.5",
        "patch-package": "^8.0.1",
        "tsdown": "^0.22.14",
        "tslib": "^2.8.1",
        "typescript": "~5.9.3",
        "vite-plugin-simple-html": "^1.1.0",
        "vite-plugin-static-copy": "^4.1.1",
        "vue-tsc": "^3.3.9"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ],
        "rules": {
            "type-enum": [
                2,
                "always",
                [
                    "chore",
                    "ci",
                    "docs",
                    "feat",
                    "fix",
                    "perf",
                    "refactor",
                    "revert",
                    "style",
                    "test"
                ]
            ]
        }
    },
    "lint-staged": {
        "**/*.{js,json,ts,html}": [
            "eslint --fix"
        ]
    },
    "packageManager": "npm@12.0.2",
    "allowScripts": {
        "@hug/eslint-config": true,
        "fsevents": true,
        "esbuild": true,
        "nx": true,
        "@parcel/watcher": true,
        "lmdb": true,
        "msgpackr-extract": true,
        "@swc/core": true,
        "edgedriver": false,
        "geckodriver": false,
        "core-js": false,
        "less": false
    }
}
