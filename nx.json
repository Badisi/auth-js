{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "neverConnectToCloud": true,
    "analytics": false,
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*",
            "sharedGlobals"
        ],
        "production": [
            "default",
            "!{workspaceRoot}/vitest.config.mts",
            "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
            "!{projectRoot}/*.config.mts"
        ],
        "sharedGlobals": []
    },
    "targetDefaults": {
        "build": {
            "cache": true,
            "inputs": [
                "production",
                "^production"
            ]
        },
        "@nx/eslint:lint": {
            "cache": true,
            "inputs": [
                "default",
                "{workspaceRoot}/eslint.config.mts"
            ]
        },
        "@nx/vitest:test": {
            "cache": true,
            "options": {
                "configFile": "{workspaceRoot}/vitest.config.mts",
                "testFiles": [
                    "{projectRoot}"
                ]
            },
            "inputs": [
                "default",
                "{workspaceRoot}/vitest.config.mts"
            ]
        },
        "nx-release-publish": {
            "options": {
                "packageRoot": "{workspaceRoot}/dist/{projectName}"
            }
        }
    },
    "plugins": [
        {
            "plugin": "@nx/js/typescript",
            "options": {
                "typecheck": {
                    "targetName": "typecheck"
                }
            }
        }
    ],
    "release": {
        "projectsRelationship": "independent",
        "releaseTag": {
            "pattern": "@badisi/{projectName}@{version}"
        },
        "version": {
            "preVersionCommand": "npm run build",
            "manifestRootsToUpdate": [
                "{projectRoot}",
                "{workspaceRoot}/dist/{projectName}"
            ],
            "conventionalCommits": true
        },
        "changelog": {
            "projectChangelogs": {
                "createRelease": "github"
            }
        },
        "conventionalCommits": {
            "types": {
                "feat": {
                    "semverBump": "minor",
                    "changelog": {
                        "title": "🚀 Features"
                    }
                },
                "fix": {
                    "semverBump": "patch",
                    "changelog": {
                        "title": "🐛 Fixes"
                    }
                },
                "perf": {
                    "semverBump": "patch",
                    "changelog": {
                        "title": "🔥 Performance"
                    }
                },
                "docs": {
                    "semverBump": "patch",
                    "changelog": {
                        "title": "📖 Documentation"
                    }
                },
                "refactor": {
                    "semverBump": "patch",
                    "changelog": false
                },
                "style": {
                    "semverBump": "patch",
                    "changelog": false
                },
                "test": {
                    "semverBump": "patch",
                    "changelog": false
                },
                "revert": {
                    "semverBump": "patch",
                    "changelog": false
                },
                "chore": false,
                "ci": false
            }
        }
    }
}
