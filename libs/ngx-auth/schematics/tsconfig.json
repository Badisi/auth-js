{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "../../../dist/ngx-auth/schematics",
        "tsBuildInfoFile": "../../../node_modules/.tmp/typecheck/ngx-auth.schematics.tsbuildinfo",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "composite": true,
        "declaration": true,
