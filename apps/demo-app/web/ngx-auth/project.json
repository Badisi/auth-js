{
    "name": "demo-ngx-auth",
    "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/demo-app/web/ngx-auth/src",
    "projectType": "application",
    "tags": [],
    "targets": {
        "serve": {
            "executor": "@angular/build:dev-server",
            "options": {
                "buildTarget": "demo-ngx-auth:build:development",
                "host": "0.0.0.0"
            }
        },
        "build": {
            "executor": "@angular/build:application",
            "outputs": [
                "{workspaceRoot}/dist/demo-app/ngx-auth"
            ],
            "options": {
                "outputPath": {
                    "base": "{workspaceRoot}/dist/demo-app/ngx-auth",
                    "browser": ""
                },
                "index": "{projectRoot}/src/index.html",
                "browser": "{projectRoot}/src/main.ts",
                "tsConfig": "{projectRoot}/tsconfig.json",
                "inlineStyleLanguage": "scss",
                "conditions": [
                    "development"
                ],
                "polyfills": [
                    "zone.js"
                ],
                "allowedCommonJsDependencies": [
                    "crypto-js"
                ],
                "assets": [
                    {
                        "input": "{projectRoot}/public",
                        "glob": "**/*"
                    },
                    {
                        "input": "{workspaceRoot}/libs/auth-js/oidc/assets",
                        "glob": "**/*",
                        "output": "oidc/callback"
                    }
                ],
                "styles": [
                    "{projectRoot}/src/styles.scss"
                ]
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "500kb",
                            "maximumError": "1mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "4kb",
                            "maximumError": "8kb"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "tsConfig": "{projectRoot}/tsconfig.dev.json",
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                }
            },
            "defaultConfiguration": "production"
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        }
    }
}
